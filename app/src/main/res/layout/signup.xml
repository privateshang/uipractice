<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="422dp"
        android:layout_height="744dp"
        tools:layout_editor_absoluteX="-6dp"
        tools:layout_editor_absoluteY="-7dp">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="SIGN UP "
            android:textColor="@color/white"
            android:textSize="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view2"
            android:layout_width="369dp"
            android:layout_height="556dp"
            android:layout_marginTop="91dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView6" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="102dp"
            android:layout_height="37dp"
            android:text="First name:"
            android:textColor="@color/white"
            android:textSize="18dp"
            tools:layout_editor_absoluteX="59dp"
            tools:layout_editor_absoluteY="204dp" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="121dp"
            android:layout_height="34dp"
            android:text="Second name:"
            android:textColor="@color/white"
            android:textSize="18dp"
            tools:layout_editor_absoluteX="58dp"
            tools:layout_editor_absoluteY="294dp" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="90dp"
            android:layout_height="39dp"
            android:text="Username:"
            android:textColor="@color/white"
            android:textSize="18dp"
            tools:layout_editor_absoluteX="58dp"
            tools:layout_editor_absoluteY="371dp" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="127dp"
            android:layout_height="26dp"
            android:text="Phone number"
            android:textColor="@color/white"
            android:textSize="18dp"
            tools:layout_editor_absoluteX="58dp"
            tools:layout_editor_absoluteY="473dp" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="90dp"
            android:layout_height="39dp"
            android:text="Password"
            android:textColor="@color/white"
            android:textSize="18dp"
            tools:layout_editor_absoluteX="58dp"
            tools:layout_editor_absoluteY="556dp" />

        <EditText
            android:id="@+id/editTextText3"
            android:layout_width="185dp"
            android:layout_height="39dp"
            android:ems="10"
            android:inputType="text"
            android:text=""
            android:textColor="@color/white"
            app:circularflow_radiusInDP="3dp"
            tools:layout_editor_absoluteX="199dp"
            tools:layout_editor_absoluteY="372dp" />

        <EditText
            android:id="@+id/editTextText6"
            android:layout_width="185dp"
            android:layout_height="39dp"
            android:ems="10"
            android:inputType="text"
            android:password="true"
            android:text=""
            android:textColor="@color/white"
            app:circularflow_radiusInDP="3dp"
            tools:layout_editor_absoluteX="199dp"
            tools:layout_editor_absoluteY="555dp" />

        <EditText
            android:id="@+id/editTextText7"
            android:layout_width="185dp"
            android:layout_height="39dp"
            android:ems="10"
            android:inputType="phone"
            android:phoneNumber="true"
            android:text=""
            android:textColor="@color/white"
            app:circularflow_radiusInDP="3dp"
            tools:layout_editor_absoluteX="199dp"
            tools:layout_editor_absoluteY="459dp" />

        <EditText
            android:id="@+id/editTextText5"
            android:layout_width="185dp"
            android:layout_height="39dp"
            android:ems="10"
            android:inputType="text"
            android:text=""
            android:textColor="@color/white"
            app:circularflow_radiusInDP="3dp"
            tools:layout_editor_absoluteX="199dp"
            tools:layout_editor_absoluteY="288dp" />

        <EditText
            android:id="@+id/editTextText4"
            android:layout_width="185dp"
            android:layout_height="39dp"
            android:ems="10"
            android:inputType="text|textPersonName|textCapSentences"
            android:text=""
            android:textColor="@color/white"
            app:circularflow_radiusInDP="3dp"
            tools:layout_editor_absoluteX="199dp"
            tools:layout_editor_absoluteY="203dp" />

        <Button
            android:id="@+id/button2"
            android:layout_width="302dp"
            android:layout_height="36dp"
            android:text="Register"
            tools:layout_editor_absoluteX="71dp"
            tools:layout_editor_absoluteY="632dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>